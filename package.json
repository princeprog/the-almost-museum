    "dexie": "^4.4.5",
    "lucide-react": "^1.33.0",
    "motion": "13.1.1",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "7.86.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
